      "style": "styles/jongno-dark/style.json",
      "serve_rendered": true,
      "serve_data": true
    },
    "osm-bright": {
      "style": "styles/osm-bright/style.json",
      "serve_rendered": true,
      "serve_data": true
    }
  },
  "data": {
    "jongno-data": {
      "mbtiles": "jongno.mbtiles"
    }
  }
}
