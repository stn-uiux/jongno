{
  "options": {
    "paths": {
      "root": "/data",
      "fonts": "fonts",
      "styles": "styles",
      "mbtiles": ""
    },
    "domains": ["*"],
    "formatQuality": {
      "jpeg": 85,
      "webp": 85,
      "png": 9
    }
  },
  "styles": {
